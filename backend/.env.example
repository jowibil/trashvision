# TrashVision backend — copy to backend/.env and fill in REAL values.
# backend/.env holds live secrets and is gitignored (*.env in .gitignore);
# never commit or print it.

# --- Required secrets / endpoints (no defaults; app refuses to start without them) ---
DATABASE_URL=postgresql://user:password@host:5432/trashvision
SECRET_KEY=change-me-to-a-long-random-string
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_EMAIL=
SMTP_PASSWORD=
GEMINI_API_KEY=
# Gemini model id used by the chatbot, e.g. gemini-2.5-flash
GEMINI_MODEL_NAME=

# --- Optional deployment knobs (defaults shown) ---

# Comma-separated browser origins allowed to call this API. Set the deployed
# portal's origin for production, e.g. CORS_ORIGINS=https://app.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Weekly critical-area insights sweep (daemon thread). With multiple uvicorn
# workers leave this True on exactly ONE process; recommended setup is
# --workers 1 (YOLO inference is already semaphore-bounded).
SWEEP_ENABLED=True

# Upload temp-file reaper for backend/temp (hourly sweep, deletes files this
# many hours old). Disable only if something else manages that directory.
TEMP_CLEANER_ENABLED=True
TEMP_FILE_MAX_AGE_HOURS=24

# JWT lifetime in minutes. Default 43200 = 30 days, a deliberate long-lived
# citizen-app session policy; override if a shorter token life is wanted.
ACCESS_TOKEN_EXPIRE_MINUTES=43200
# JWT signing algorithm (keep HS256 unless rotating to RS256 deliberately)
ALGORITHM=HS256
