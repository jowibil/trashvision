# TrashVision mobile environment template.
# Copy to mobile/.env and fill in real values. mobile/.env is gitignored but
# IS bundled into release builds as a pubspec asset — keep secrets intentional.

# Root API host. Bare hosts get http:// assumed (LAN dev convenience).
# REQUIRED in release builds: without it the app throws a clear
# StateError at startup instead of silently failing every request.
API_BASE_URL=http://192.168.254.104:8000

# Mapbox access token for the map tile layer (streets-v12 raster tiles).
MAP_API=
