# TrashVision web portal — copy to web/.env and fill in.
# Every value here is non-secret (baked into the public bundle at build time).

# Backend API root, no trailing slash. REQUIRED for production builds —
# `npm run build` bundles it into dist/ and requests fail loudly without it.
# Dev builds fall back to http://127.0.0.1:8000 when this is unset.
VITE_API_URL=http://127.0.0.1:8000
